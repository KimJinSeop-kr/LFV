        "import pandas as pd\n",
        "import os\n",
        "import re\n",
        "import hashlib\n",
        "import random\n",
        "import json\n",
        "\n",
        "from sys import version_info\n",
        "python_version = f\"{version_info.major}.{version_info.minor}\"\n",
        "\n",
        "# 표준 아미노산 문자만 유지, 나머지 문자 제거\n",
        "def clean_sequence(seq):\n",
        "    return re.sub(r'[^ACDEFGHIKLMNPQRSTVWY]', '', seq.upper())\n",
        "\n",
        "def add_hash(x,y):\n",
        "  return x+\"_\"+hashlib.sha1(y.encode()).hexdigest()[:5]\n",
        "\n",
        "def print_sequences_in_range(df, start_index, end_index):\n",
        "    selected = df.iloc[start_index:end_index + 1]\n",
        "    for idx, row in selected.iterrows():\n",
        "        sequence = row['query_sequence']\n",
        "        print(f\"index: {idx}\")\n",
        "        print(f\"id: {row['Enzyme_ID']}\")\n",
        "        print(f\"sequence length: {len(sequence)}\")\n",
        "        print(f\"sequence: {sequence}\\n\")\n",
        "\n",
        "#@title Input JSON File Path\n",
        "#@markdown Upload a JSON file and specify the path here. It must contain a key called `\"sequence\"` with the amino acid sequence.\n",
        "query_sequence_path = \"/content/drive/MyDrive/Signal_P_Project/Result_data_save.json\"  #@param {type:\"string\"}\n",
        "with open(query_sequence_path, 'r') as f:\n",
        "    json_data = json.load(f)\n",
        "raw_df = pd.DataFrame(json_data)\n",
        "\n",
        "query_sequence_list = raw_df.apply(\n",
        "    lambda row: {\n",
        "        'Enzyme_ID': row['ID'],\n",
        "        'query_sequence': row['Sp'] + row['TFP'] + row['Linker'] + row['Enzyme_sequence']\n",
        "    },\n",
        "    axis=1\n",
        ").tolist() # ➡️ Series의 값(딕셔너리)들을 리스트로 변환\n",
        "\n",
        "# ➡️ 리스트를 사용하여 DataFrame을 생성\n",
        "query_sequence_df = pd.DataFrame(query_sequence_list)\n",
        "\n",
        "\n",
        "jobname = 'test' #@param {type:\"string\"}\n",
        "# number of models to use\n",
        "start_index = 1501  #@param {type:\"integer\"}\n",
        "end_index = 1679    #@param {type:\"integer\"}\n",
        "num_relax = 0 #@param [0, 1, 5] {type:\"raw\"}\n",
        "#@markdown - specify how many of the top ranked structures to relax using amber\n",
        "template_mode = \"none\" #@param [\"none\", \"pdb100\",\"custom\"]\n",
        "#@markdown - `none` = no template information is used. `pdb100` = detect templates in pdb100 (see [notes](#pdb100)). `custom` - upload and search own templates (PDB or mmCIF format, see [notes](#custom_templates))\n",
        "\n",
        "use_amber = num_relax > 0\n",
        "\n",
        "# remove whitespaces\n",
        "query_sequence_df['query_sequence'] = query_sequence_df['query_sequence'].apply(\n",
        "    lambda x: \"\".join(x.split()))\n",
        "query_sequence_df['query_sequence'] = query_sequence_df['query_sequence'].apply(clean_sequence)\n",
        "\n",
        "basejobname = \"\".join(jobname.split())\n",
        "basejobname = re.sub(r'\\W+', '', basejobname)\n",
        "jobname = add_hash(basejobname, f\"{start_index}-{end_index}\")\n",
        "\n",
        "# check if directory with jobname exists\n",
        "def check(folder):\n",
        "  if os.path.exists(folder):\n",
        "    return False\n",
        "  else:\n",
        "    return True\n",
        "if not check(jobname):\n",
        "  n = 0\n",
        "  while not check(f\"{jobname}_{n}\"): n += 1\n",
        "  jobname = f\"{jobname}_{n}\"\n",
        "\n",
        "# make directory to save results\n",
        "os.makedirs(jobname, exist_ok=True)\n",
        "\n",
        "# save queries\n",
        "# 선택된 범위만 슬라이싱\n",
        "selected_df = query_sequence_df.iloc[start_index:end_index + 1]\n",
        "queries_path = os.path.join(jobname, f\"{jobname}.csv\")\n",
        "os.makedirs(jobname, exist_ok=True)\n",
        "selected_df[['Enzyme_ID', 'query_sequence']].to_csv(\n",
        "    queries_path,\n",
        "    index=False,\n",
        "    header=['id', 'sequence']\n",
        ")\n",
        "if template_mode == \"pdb100\":\n",
        "  use_templates = True\n",
        "  custom_template_path = None\n",
        "elif template_mode == \"custom\":\n",
        "  custom_template_path = os.path.join(jobname,f\"template\")\n",
        "  os.makedirs(custom_template_path, exist_ok=True)\n",
        "  uploaded = files.upload()\n",
        "  use_templates = True\n",
        "  for fn in uploaded.keys():\n",
        "    os.rename(fn,os.path.join(custom_template_path,fn))\n",
        "else:\n",
        "  custom_template_path = None\n",
        "  use_templates = False\n",
        "\n",
        "print(\"jobname\",jobname)\n",
        "print_sequences_in_range(query_sequence_df, start_index, end_index)"
      ]
    },
